<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 1. Google Drive -->
        <TextView
            style="@style/TextAppearance.AppCompat.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1. Google Drive" />

        <TextView
            android:id="@+id/driveStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <Button
            android:id="@+id/connectDrive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Connect Google Drive" />

        <!-- 2. Calls folder -->
        <TextView
            style="@style/TextAppearance.AppCompat.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="2. Calls folder" />

        <TextView
            android:id="@+id/folderStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <Button
            android:id="@+id/pickFolder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Choose calls folder" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:alpha="0.7"
            android:text="That's all. After each call, the recording is synced to Google Drive → HushSync → month and then removed from the phone, on Wi-Fi or mobile data." />

    </LinearLayout>
</ScrollView>
